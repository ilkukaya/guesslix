{
  "name": "guesslix",
  "version": "1.0.0",
  "description": "Guesslix — Programmatic quiz video generation",
  "scripts": {
    "dev": "remotion studio",
    "render:long": "remotion render LongQuiz",
    "render:short": "remotion render ShortQuiz",
    "render:flags-long": "remotion render LongQuizV3 out/flags-197-long.mp4 --concurrency=4",
    "render:flags-short": "remotion render ShortQuizV3 out/flags-10-short.mp4 --concurrency=4",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@remotion/cli": "4.0.242",
    "@remotion/google-fonts": "4.0.242",
    "flag-icons": "^7.5.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "remotion": "4.0.242"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "typescript": "^5.6.3"
  }
}
